<ContentPage
    x:Class="BooxBox.BooksPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Mijn Boeken">


    <Grid RowDefinitions="Auto,*">

        <SearchBar Placeholder="Zoek een boek..." Margin="10" />

        <CollectionView Grid.Row="1" Margin="10" ItemsSource="{Binding Books}">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border StrokeThickness="1" Padding="10" Margin="0,5" StrokeShape="RoundRectangle 12">
                        <Grid ColumnDefinitions="80,*" ColumnSpacing="10">
                            <Label Grid.Column="0" Text="📚" FontSize="40" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="{Binding Title}" FontSize="18" FontAttributes="Bold" />
                                <Label Text="{Binding Author}" TextColor="Gray" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
