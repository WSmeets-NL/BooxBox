<ContentPage
    x:Class="BooxBox.BooksPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Mijn Boeken">


    <Grid RowDefinitions="Auto,*">

        <SearchBar Placeholder="Zoek een boek..." Margin="10" />

        <CollectionView Grid.Row="1" Margin="10">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,5" Padding="10">
                        <VerticalStackLayout>
                            <Label Text="Boektitel" FontSize="18" FontAttributes="Bold" />
                            <Label Text="Auteur" TextColor="Gray" />
                            <Label Text="Uitgeverij" FontSize="12" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
