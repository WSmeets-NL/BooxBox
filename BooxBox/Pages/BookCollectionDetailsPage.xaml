<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BooxBox.Pages.BookCollectionDetailsPage"
             Title="BookCollectionDetailsPage">
    <VerticalStackLayout>
        <Border Background="MintCream" Padding="10">
            <Grid RowDefinitions="2*, *">
                <Label
                    Grid.Row="0"
                    Text="{Binding ChosenCollection.Name}"
                    VerticalOptions="Center" 
                    HorizontalOptions="Center"
                    FontSize="48"
                    TextColor="Black"
                    Padding="24"/>

                <Label
                    Grid.Row="1"
                    Text="{Binding ChosenCollection.Description}"
                    VerticalOptions="Center" 
                    HorizontalOptions="Center"
                    FontSize="24"                 
                    TextColor="Black" />
            </Grid>
        </Border>

        <Grid Margin="10" ColumnDefinitions="*, 3*, *,  3*, *">
            <Button Grid.Column="1" Text="Wijzig naam verzameling" Clicked="ChangeCollectionName" BackgroundColor="DarkBlue" TextColor="White" />
            <Button Grid.Column="3" Text="Wijzig beschrijving verzameling" Clicked="ChangeCollectionDescription" BackgroundColor="DarkBlue" TextColor="White" />
        </Grid>

        <CollectionView x:Name="BooksInCollection" Margin="10">

            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="2" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="MintCream" StrokeThickness="1" Padding="10" Margin="10" StrokeShape="RoundRectangle 12">
                        <Grid RowDefinitions="80, *, 50"  ColumnSpacing="10">
                            <Image Grid.Row="0"  Source="missingcover.png" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Row="1">
                                <Label Text="{Binding Title}" HorizontalTextAlignment="Center" FontSize="18" FontAttributes="Bold" TextColor="Black"/>
                            </VerticalStackLayout>
                            <Grid Grid.Row="2" ColumnDefinitions="3*, *" Margin="2">
                                <Button Grid.Column="0" BindingContext="{Binding Id}" Clicked="ToBookDetails" Text="bekijk boek" BackgroundColor="DarkBlue" TextColor="White" Margin="1"/>
                                <Button Grid.Column="1" BindingContext="{Binding Id}" Clicked="RemoveBook" Text="Verwijder boek" BackgroundColor="DarkRed" TextColor="White" Margin="1"/>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>