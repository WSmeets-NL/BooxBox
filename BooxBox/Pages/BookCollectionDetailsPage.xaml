<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BooxBox.Pages.BookCollectionDetailsPage"
             Title="BookCollectionDetailsPage">
    <VerticalStackLayout>
        <Border Background="LightCoral">
            <Grid RowDefinitions="2*, *">
                <Label
                    Grid.Row="0"
                    Text="{Binding ChosenCollection.Name}"
                    VerticalOptions="Center" 
                    HorizontalOptions="Center"
                    FontSize="48"
                    TextColor="Black"
                    Padding="24"/>

                <Label
                    Grid.Row="1"
                    Text="{Binding ChosenCollection.Description}"
                    VerticalOptions="Center" 
                    HorizontalOptions="Center"
                    FontSize="24"                 
                    TextColor="Black" />
            </Grid>
        </Border>

        <CollectionView x:Name="BooksInCollection" Margin="10">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="MintCream" StrokeThickness="1" Padding="10" Margin="10" StrokeShape="RoundRectangle 12">
                        <Grid ColumnDefinitions="*, 3*, *,*">
                            <Image Grid.Column="0" Source="missingcover.png" />
                            <Label Grid.Column="1" Text="{Binding Title}" HorizontalTextAlignment="Center" FontSize="18" FontAttributes="Bold" TextColor="Black" />
                            <Button Grid.Column="2" BindingContext="{Binding Id}" Clicked="ToBookDetails" Text="bekijk boek" TextColor="White" Margin="1"/>
                            <Button Grid.Column="3" BindingContext="{Binding Id}" Clicked="RemoveBook" Text="Verwijder boek" BackgroundColor="DarkRed" TextColor="White" Margin="1"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        
        
        
    </VerticalStackLayout>
</ContentPage>