<ContentPage
    x:Class="BooxBox.Pages.AddBookPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Boek toevoegen">

    <ScrollView>

        <VerticalStackLayout Padding="24" Spacing="20">

            <Label Text="Voeg een boek toe" FontSize="28" FontAttributes="Bold" />

            <Label Text="Kies hoe je een nieuw boek aan je collectie wilt toevoegen." FontSize="14" TextColor="Gray" />

            <Border BackgroundColor="MintCream" Padding="20" StrokeShape="RoundRectangle 16">

                <Grid ColumnDefinitions="60,*" ColumnSpacing="15">
                    <Image Grid.Column="0" Source="manualadd.png" HeightRequest="60" WidthRequest="60" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="Handmatig toevoegen" FontSize="18" FontAttributes="Bold" TextColor="Black" />
                        <Label Text="Vul de gegevens van het boek zelf in" TextColor="Gray"  />
                    </VerticalStackLayout>
                </Grid>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="ManualAddNavigation"/>
                </Border.GestureRecognizers>
            </Border>


            <Border BackgroundColor="MintCream" Padding="20" StrokeShape="RoundRectangle 16">

                <Grid ColumnDefinitions="60,*" ColumnSpacing="15">
                    <Image Grid.Column="0" Source="searchadd.png" HeightRequest="60" WidthRequest="60" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1"  Spacing="4">
                        <Label Text="Boek halen uit OpenLibrary" FontSize="18" FontAttributes="Bold" TextColor="Black"/>
                        <Label Text="Geef de titel, en je boek wordt automatisch opgehaald vanuit OpenLibrary.org" TextColor="Gray" />
                        <Label Text="Let op! Het kan voorkomen dat het boek dat je zoekt niet in OpenLibrary staat." TextColor="Gray" />
                    </VerticalStackLayout>
                </Grid>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="SearchAddNavigation"/>
                </Border.GestureRecognizers>
            </Border>

            <Border BackgroundColor="MintCream" Padding="20" StrokeShape="RoundRectangle 16">
                <Grid ColumnDefinitions="60,*" ColumnSpacing="15">
                    <Image Grid.Column="0" Source="scanadd.png" HeightRequest="60" WidthRequest="60" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="Barcode scannen" FontSize="18" FontAttributes="Bold" TextColor="Black"/>
                        <Label Text="Scan de barcode om de gegevens op te halen." TextColor="Gray" />
                        <Label Text=" Let op! Het kan voorkomen dat je boek niet gevonden kan worden." TextColor="Gray" />
                    </VerticalStackLayout>
                </Grid>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="ScanAddNavigation"/>
                </Border.GestureRecognizers>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
