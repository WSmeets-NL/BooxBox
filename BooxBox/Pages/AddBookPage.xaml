<ContentPage
    x:Class="BooxBox.AddBookPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Boek toevoegen">

    <ScrollView>

        <VerticalStackLayout Padding="24" Spacing="20">

            <Label Text="Voeg een boek toe" FontSize="28" FontAttributes="Bold" />

            <Label Text="Kies hoe je een nieuw boek aan je collectie wilt toevoegen." FontSize="14" TextColor="Gray" />

            <Border Padding="20" StrokeShape="RoundRectangle 16">

                <Grid ColumnDefinitions="60,*" ColumnSpacing="15">
                    <Image Grid.Column="0" Source="manualadd.svg" HeightRequest="32" WidthRequest="32" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="Handmatig toevoegen" FontSize="18" FontAttributes="Bold" />
                        <Label Text="Vul de gegevens van het boek zelf in" TextColor="Gray" />
                    </VerticalStackLayout>
                </Grid>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="ManualAddNavigation"/>
                </Border.GestureRecognizers>
            </Border>


            <Border Padding="20" StrokeShape="RoundRectangle 16">

                <Grid ColumnDefinitions="60,*" ColumnSpacing="15">
                    <Image Grid.Column="0" Source="searchadd.svg" HeightRequest="32" WidthRequest="32" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="0"  Spacing="4">
                        <Label Text="Boek opzoeken" FontSize="18" FontAttributes="Bold" />
                        <Label Text="Zoek een boek op basis van de titel" TextColor="Gray" />
                    </VerticalStackLayout>
                </Grid>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="SearchAddNavigation"/>
                </Border.GestureRecognizers>
            </Border>

            <Border Padding="20" StrokeShape="RoundRectangle 16">
                <Grid ColumnDefinitions="60,*" ColumnSpacing="15">
                    <Image Grid.Column="0" Source="scanadd.svg" HeightRequest="32" WidthRequest="32" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="Barcode scannen" FontSize="18" FontAttributes="Bold" />
                        <Label Text="Scan de barcode om de gegevens op te halen." TextColor="Gray" />
                    </VerticalStackLayout>
                </Grid>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="ScanAddNavigation"/>
                </Border.GestureRecognizers>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
