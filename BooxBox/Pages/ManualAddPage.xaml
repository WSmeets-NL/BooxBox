<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BooxBox.Pages.ManualAddPage"
             Title="Handmatig toevoegen">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
           
            <Label Text="Nieuw boek toevoegen" HorizontalTextAlignment="Center" FontSize="30" FontAttributes="Bold" />
            <Label Text="inputvelden met een * zijn verplicht" HorizontalTextAlignment="Center" FontSize="16" />

            <Label Text="Wat is de titel? *" FontSize="18" />
            <Entry Placeholder="Voer de titel in" x:Name="TitleEntry" />

            <Label Text="Wie is de auteur? *" FontSize="18"/>
            <Grid ColumnDefinitions="4*, *">
                <Picker Grid.Column="0" x:Name="AuthorPicker" ItemDisplayBinding="{Binding Name}"/>
                <Button Grid.Column="1" Clicked="AddNewAuthor" Text="Nieuwe Auteur" BackgroundColor="LightBlue" />
            </Grid>
            
            <Label Text="Wie is de illustrator?" FontSize="18"/>
            <Label Text="Is er geen illustrator, laat dit veld dan leeg." FontSize="12" />
            <Grid ColumnDefinitions="4*, *">
                <Picker Grid.Column="0" x:Name="IllustratorPicker" ItemDisplayBinding="{Binding Name}"/>
                <Button Grid.Column="1" Clicked="AddNewIllustrator" Text="Nieuwe Illustrator" BackgroundColor="LightBlue"  />
            </Grid>

            <Label Text="In welke taal is het boek geschreven? *" FontSize="18"/>
            <Grid ColumnDefinitions="4*, *">
                <Picker Grid.Column="0" x:Name="LanguagePicker" ItemDisplayBinding="{Binding Description}" />
                <Button Grid.Column="1" Clicked="AddNewLanguage" Text="Nieuwe Taal" BackgroundColor="LightBlue"  />
            </Grid>

            <Label Text="In welke locatie wil je dit boek bewaren?" FontSize="18"/>
            <Grid ColumnDefinitions="4*, *">
                <Picker Grid.Column="0" x:Name="LocationPicker" ItemDisplayBinding="{Binding Name}" />
                <Button Grid.Column="1" Clicked="AddNewLocation" Text="Nieuwe Locatie" BackgroundColor="LightBlue"  />
            </Grid>

            <Label Text="Wil je dit boek al toevoegen aan een verzameling?" FontSize="18"/>
            <Grid ColumnDefinitions="4*, *">
                <Picker Grid.Column="0" x:Name="CollectionPicker" ItemDisplayBinding="{Binding Name}" />
                <Button Grid.Column="1" Clicked="AddNewCollection" Text="Nieuwe Verzameling" BackgroundColor="LightBlue"  />
            </Grid>

            <Button Text="Boek toevoegen" Clicked="OnClickSubmit"  BackgroundColor="LightBlue"  />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>