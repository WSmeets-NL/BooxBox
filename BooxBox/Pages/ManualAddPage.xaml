<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BooxBox.Pages.ManualAddPage"
             Title="ManualAddPage">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            
            <Label Text="Nieuw boek toevoegen" FontSize="24" FontAttributes="Bold" />
            
            <Label Text="Titel" />
            <Entry Placeholder="Voer de titel in" Text="{Binding Title}" />

            <Label Text="Auteur" />
            <Entry Placeholder="Voer de auteur in" Text="{Binding Author}" />

            <Label Text="ISBN" />
            <Entry Placeholder="9781234567890" Keyboard="Numeric" Text="{Binding ISBN}" />

            <Label Text="Aantal pagina's" />
            <Entry Placeholder="100" Keyboard="Numeric" Text="{Binding NumberOfPages}" />
            
            <Label Text="Uitgeverij"/>
            <Entry Placeholder="Voer hier de uitgeverij in." Text="{Binding Publisher}" />

            <Label Text="Publicatiedatum" />
            <DatePicker Date="{Binding PublicationDate}" />
            
            <!-- Opslaan -->
            <Button Text="Boek opslaan" Command="{Binding SaveCommand}" BackgroundColor="DarkBlue" TextColor="White" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>