<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BooxBox.Pages.BookLocationPage"
             Title="Mijn Locaties">

    <Grid RowDefinitions="Auto, Auto, *">


        <Grid ColumnDefinitions="*,*" Grid.Row="0" Margin="10">
            <Button Grid.Column="0" Text="+ Nieuwe locatie aanmaken" Clicked="AddBookLocation" BackgroundColor="DarkBlue" TextColor="White" Margin="10" />
            <Button Grid.Column="1" Text="Sorteer A-Z" Margin="10" Clicked="SortAlphabetically" BackgroundColor="DarkBlue" TextColor="White" />
        </Grid>

        <SearchBar Grid.Row="1" Placeholder="Zoek een Locatie" Margin="10" TextChanged="SearchLocation" />


        <CollectionView x:Name="BookLocationView" Grid.Row="2" Margin="10">

            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="3" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="MintCream" StrokeThickness="1" Padding="10" Margin="10" StrokeShape="RoundRectangle 12">
                        <Grid RowDefinitions="80,*, 50" ColumnSpacing="10">
                            <Image Grid.Row="0"  Source="genericbookcase.png" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Row="1">
                                <Label Text="{Binding Name}" HorizontalTextAlignment="Center" FontSize="18" FontAttributes="Bold" TextColor="Black"/>
                            </VerticalStackLayout>
                            <Grid Grid.Row="2" ColumnDefinitions="3*, *" Margin="2">
                                <Button Grid.Column="0" Text="Details" Clicked="ToLocationDetails" BackgroundColor="DarkBlue" TextColor="White" Margin="1" />
                                <Button Grid.Column="1" Text="Verwijder" BindingContext="{Binding Id}" Clicked="DeleteLocation" BackgroundColor="DarkRed" TextColor="White" Margin="1" />
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>