<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BooxBox.Pages.BookDetailsPage"
             Title="BookDetailsPage">
    <VerticalStackLayout>
        <Border Background="LightCoral">
            <Label 
            Text="{Binding ChosenBook.Title}"
            VerticalOptions="Center" 
            HorizontalOptions="Center"
            FontSize="48"
            TextColor="Black"
            Padding="24"/>
        </Border>
        <Grid ColumnDefinitions="*, 2*" Padding="24">


            <Image Grid.Column="0" Source="missingcover.png" VerticalOptions="Center"/>
            <Grid Grid.Column="1" RowDefinitions="*, *, *, *, *">
                <VerticalStackLayout Grid.Row="0">
                    <Border StrokeThickness="1" Padding="10" Margin="10" StrokeShape="RoundRectangle 12">
                        <Grid ColumnDefinitions="*, 3*, *" >
                            <Label Grid.Column="0" Text="Auteur:" FontSize="24" HorizontalTextAlignment="Center"/>
                            <Label Grid.Column="1" Text="{Binding BookAuthor}" FontSize="24" HorizontalTextAlignment="Start"/>
                            <Button Grid.Column="2" Text="wijzig" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Row="1">
                    <Border StrokeThickness="1" Padding="10" Margin="10" StrokeShape="RoundRectangle 12">
                        <Grid ColumnDefinitions="*, 3*, *" >
                            <Label Grid.Column="0" Text="Illustrator:" FontSize="24" HorizontalTextAlignment="Center"/>
                            <Label Grid.Column="1" Text="{Binding BookIllustrator}" FontSize="24" HorizontalTextAlignment="Start"/>
                            <Button Grid.Column="2" Text="wijzig" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Row="2">
                    <Border StrokeThickness="1" Padding="10" Margin="10" StrokeShape="RoundRectangle 12">
                        <Grid ColumnDefinitions="*, 3*, *" >
                            <Label Grid.Column="0" Text="Taal:" FontSize="24" HorizontalTextAlignment="Center"/>
                            <Label Grid.Column="1" Text="{Binding BookLanguage}" FontSize="24" HorizontalTextAlignment="Start"/>
                            <Button Grid.Column="2" Text="wijzig" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Row="3">
                    <Border StrokeThickness="1" Padding="10" Margin="10" StrokeShape="RoundRectangle 12">
                        <Grid ColumnDefinitions="*, 3*, *" >
                            <Label Grid.Column="0" Text="Locatie:" FontSize="24" HorizontalTextAlignment="Center"/>
                            <Label Grid.Column="1" Text="{Binding BookLocation}" FontSize="24" HorizontalTextAlignment="Start"/>
                            <Button Grid.Column="2" Text="wijzig" Clicked="ChangeBookLocation"/>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Row="4">
                    <Border Grid.Row="1" StrokeThickness="1"  Padding="10" Margin="10" StrokeShape="RoundRectangle 12">
                        <Grid RowDefinitions="*, 4*">
                            <Grid Grid.Row="0" ColumnDefinitions="4*, *">
                                <Label Grid.Column="0" Text="Verzamelingen:" FontSize="24" HorizontalTextAlignment="Start"/>
                                <Button Grid.Column="1" Clicked="AddToCollection" Text="Verzameling Toevoegen"/>
                            </Grid>

                            <Grid Padding="10" Grid.Row="1">
                                <CollectionView x:Name="BookCollectionView">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="4*, *">
                                                <Label Grid.Column="0" Text="{Binding Name}" FontSize="18" VerticalTextAlignment="Center" HorizontalTextAlignment="Start" Padding="10"/>
                                                <Button Grid.Column="1" Text="Verwijder verzameling" Clicked="RemoveFromCollection" BindingContext="{Binding Id}" BackgroundColor="DarkRed" TextColor="White" Margin="1" />
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </Grid>
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </Grid>
        </Grid>
    </VerticalStackLayout>
</ContentPage>
